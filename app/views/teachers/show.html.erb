<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0"><%= t('.title') %></h5>
    <%= link_to t('actions.back'), teachers_path, class: "btn btn-sm btn-secondary" %>
  </div>
  <div class="card-body">
    <p><strong><%= t('activerecord.attributes.teacher.name') %>:</strong> <%= @teacher.name %></p>
    <p><strong><%= t('activerecord.attributes.teacher.phone_number') %>:</strong> <%= @teacher.phone_number %></p>
    <p><strong><%= t('activerecord.attributes.teacher.email') %>:</strong> <%= @teacher.email %></p>
  </div>
  <div class="card-footer d-flex gap-2">
    <%= link_to t('actions.edit'), edit_teacher_path(@teacher), class: "btn btn-warning" %>
    <%= button_to t('actions.delete'), @teacher, method: :delete, class: "btn btn-danger", data: { confirm: t('actions.confirm') } %>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header">
    <%= t('.assigned_courses') %>
  </div>
  <% if @teacher.courses.any? %>
    <ul class="list-group list-group-flush">
      <% @teacher.courses.each do |course| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= link_to course.name, course %>
          <span class="badge bg-primary rounded-pill"><%= t('.students_count', count: course.students.count) %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="card-body">
      <p class="card-text"><%= t('.no_courses') %></p>
    </div>
  <% end %>
</div>
