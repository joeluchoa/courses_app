<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('.title') %></h1>
  <%= link_to t('actions.new'), new_teacher_path, class: "btn btn-primary" %>
</div>

<div class="card mb-4 no-pdf">
  <div class="card-body">
    <%= form_with url: teachers_path, method: :get, class: "row g-3 align-items-center" do |f| %>
      <div class="col-md-4">
        <div class="input-group">
          <%= f.text_field :query, value: params[:query], class: "form-control", placeholder: t('teachers.index.search_placeholder') %>
          <%= f.submit t('actions.search'), class: "btn btn-primary" %>
        </div>
      </div>
      <div class="col-md-auto ms-auto">
        <%= link_to t('actions.clear'), teachers_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover table-sm">
    <thead>
      <tr>
        <th><%= t('activerecord.attributes.teacher.name') %></th>
        <th><%= t('activerecord.attributes.teacher.phone_number') %></th>
        <th><%= t('activerecord.attributes.teacher.email') %></th>
        <th class="text-center"><%= t('actions.title') %></th>
      </tr>
    </thead>
    <tbody class="align-middle">
      <% @teachers.each do |teacher| %>
        <tr>
          <td><span class="fw-bold"><%= teacher.name %></span></td>
          <td><i class="bi bi-telephone me-1 text-muted"></i><%= teacher.phone_number %></td>
          <td><i class="bi bi-envelope me-1 text-muted"></i><%= teacher.email %></td>
          <td class="text-center">
            <div class="btn-group">
              <%= link_to t('actions.show'), teacher, class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to t('actions.delete'), teacher, data: { turbo_method: :delete, turbo_confirm: t('actions.confirm') }, class: 'btn btn-outline-danger btn-sm' %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

