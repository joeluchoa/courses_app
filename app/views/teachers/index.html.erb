<div class="d-flex justify-content-between align-items-center mb-3">
  <h1><%= t('.title') %></h1>
  <%= link_to t('actions.new'), new_teacher_path, class: "btn btn-primary" %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover table-responsive table-sm">
    <thead>
      <tr>
        <th><%= t('activerecord.attributes.teacher.name') %></th>
        <th><%= t('activerecord.attributes.teacher.phone_number') %></th>
        <th><%= t('activerecord.attributes.teacher.email') %></th>
        <th colspan="2"><%= t('actions.title') %></th>
      </tr>
    </thead>
    <tbody class="align-middle">
      <% @teachers.each do |teacher| %>
        <tr>
          <td><%= teacher.name %></td>
          <td><%= teacher.phone_number %></td>
          <td><%= teacher.email %></td>
          <td class="col-2">
            <%= link_to t('actions.show'), teacher, class: "btn btn-sm btn-secondary" %>
            <%= link_to t('actions.delete'), teacher, data: { turbo_method: :delete, turbo_confirm: t('actions.confirm') }, class: 'btn btn-danger btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
