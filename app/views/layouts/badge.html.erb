<!DOCTYPE html>
<html>
  <head>
    <title>Student Badge - <%= @student.first_name %> <%= @student.last_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <style>
      /* Page layout for printing */
      @media print {
        @page {
          size: 206mm 132mm;
          margin: 0;
        }
        body {
          -webkit-print-color-adjust: exact; /* Ensures colors print in Chrome */
          print-color-adjust: exact; /* Standard */
        }
      }

      /* Basic setup */
      body {
        margin: 0;
        padding: 0;
        background-color: #FFF;
        width: 206mm;
        height: 132mm;
        font-family: Arial, sans-serif; /* Standard safe font */
      }

      /* Centers the badge on the page for screen viewing */
      .badge-container {
        padding: 1mm;
        text-align: center;
      }

      /* The badge itself, styled like a plastic ID card and sized for A6 landscape */
      .badge-card {
        width: 204mm;
        height: 130mm;
        background-color: #ffffff;
        border-radius: 12px;
        border: 2px solid #ccc;
        overflow: hidden; /* Keeps contents within the rounded corners */
        position: relative; /* For positioning child elements */
        margin: 0 auto;
      }

      /* Header styling */
      .badge-header {
        color: black;
        padding: 10px 18px;
        border-bottom: 1px solid #eee;
        height: 15mm;
      }
      .badge-logo {
        font-weight: 800;
        font-size: 2.5rem;
        letter-spacing: -1px;
        opacity: 0.8;
        text-align: left;
      }
      .badge-school-name {
        font-size: 1.2rem;
        text-align: center;
      }

      /* Main content area */
      .badge-body {
        height: 100mm;
        display: block;
      }

      .student-details {
        text-align: left;
        padding: 10px 20px;
      }
      .student-name {
        font-size: 2.5rem;
        padding: 2px;
        margin-bottom: 15px;
      }
      .student-name span {
        font-weight: normal;
      }
      .student-name strong {
        font-weight: bold;
      }
      .field-label {
        font-size: 1.2rem;
        color: #666;
        font-weight: normal;
        padding: 2px;
      }
      .field-value {
        font-size: 1.3rem;
        font-weight: bold;
        padding: 2px;
      }

      /* Footer area */
      .badge-footer {
        padding: 10px 18px;
        border-top: 1px solid #eee;
        height: 10mm;
        background-color: #fafafa;
      }
      
      .qr-code-area {
        width: 60mm;
        height: 60mm;
        padding: 10mm;
        background-color: white;
        text-align: center;
      }

      .qr-code-area .qr-code-container svg {
        width: 60mm;
        height: 60mm;
      }
      
      .issuing-info {
        font-size: 1rem;
        text-align: right;
        color: #999;
      }

      /* Table layout helpers */
      .full-width-table {
        width: 100%;
        border-collapse: collapse;
      }
      .align-top {
        vertical-align: top;
      }
      .align-bottom {
        vertical-align: bottom;
      }
    </style>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
