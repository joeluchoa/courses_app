<div class="card">
  <div class="card-header">
    <h3><%= t('scanner.index.title') %></h3>
  </div>
  <div class="card-body text-center">
    <p><%= t('scanner.index.instruction') %></p>
    <div style="text-align: center;" data-controller="scanner">
      <div id="qr-reader" data-scanner-target="reader" style="width: 500px; margin: 0 auto;"></div>
      <div data-scanner-target="result" id="scan-result"></div>
    </div>
  </div>
</div>
<div style="text-align: center;">
  <h1><%= t('scanner.index.header') %></h1>
</div>
