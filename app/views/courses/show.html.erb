<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0"><%= t('.title') %></h5>
    <%= link_to t('actions.back'), courses_path, class: "btn btn-sm btn-secondary" %>
  </div>

  <div class="card-body">
    <%= render @course%>
  </div>

  <div class="card-footer d-flex gap-2">
    <%= link_to t('actions.edit'), edit_course_path(@course), class: "btn btn-warning" %>
    <%= button_to t('actions.delete'), @course, method: :delete, class: "btn btn-danger", data: { turbo_confirm: t('actions.confirm') } %>
  </div>
</div>

<p/>
<p/>

<div class="row">
  <%# --- Enrolled Students Column --- %>
  <div class="col-md-7">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5><%= t('.enrolled_students') %> (<%= @enrolled_students.count %>)</h5>
        <%= link_to t('.view_attendance_sheet'), attendance_table_course_path(@course), class: 'btn btn-sm btn-outline-primary' %>
      </div>
      <div class="card-body">
        <% if @enrolled_students.any? %>
          <ul class="list-group">
            <% @enrolled_students.each_with_index do |student, index| %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <span class="text-muted small me-2"><%= index + 1 %>.</span>
                  <%= link_to student.full_name, student_path(student) %>
                </div>
                <%# Find the specific enrollment record for this student/course combo %>
                <% enrollment = @course.enrollments.find_by(student_id: student.id) %>
                <%= button_to t('actions.unenroll'), course_enrollment_path(@course, enrollment), method: :delete, class: "btn btn-xs btn-outline-danger", data: { turbo_confirm: t('actions.confirm') } %>
              </li>
            <% end %>
          </ul>

        <% else %>
          <p class="text-muted"><%= t('.no_students_enrolled') %></p>
        <% end %>
      </div>
    </div>
  </div>

  <%# --- Enroll New Student Column --- %>
  <div class="col-md-5">
    <div class="card">
      <div class="card-header">
        <h5><%= t('.enroll_student') %></h5>
      </div>
      <div class="card-body" data-controller="list-filter">
        <div class="mb-3">
          <input type="text"
                 class="form-control"
                 placeholder="<%= t('.search_student_placeholder', default: 'Search student by name...') %>"
                 data-list-filter-target="input"
                 data-action="input->list-filter#filter">
        </div>

        <div class="list-group overflow-auto" style="max-height: 400px;">
          <% @potential_students.each do |student| %>
            <div class="list-group-item d-flex justify-content-between align-items-center"
                 data-list-filter-target="item"
                 data-search-value="<%= student.full_name %>">
              <span><%= student.full_name %></span>
              <%= button_to t('actions.enroll'), course_enrollments_path(@course, enrollment: { student_id: student.id }), method: :post, class: "btn btn-sm btn-success" %>
            </div>
          <% end %>
          <% if @potential_students.empty? %>
            <div class="list-group-item text-muted text-center italic">
              <%= t('.all_students_enrolled') %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
