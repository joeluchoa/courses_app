<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('courses.index.title') %></h1>
  <%= link_to t('actions.new'), new_course_path, class: "btn btn-primary" %>
</div>

<div class="card mb-4 no-pdf">
  <div class="card-body">
    <%= form_with url: courses_path, method: :get, class: "row g-3 align-items-center" do |f| %>
      <div class="col-md-4">
        <div class="input-group">
          <%= f.text_field :query, value: params[:query], class: "form-control", placeholder: t('courses.index.search_placeholder') %>
          <%= f.submit t('actions.search'), class: "btn btn-primary" %>
        </div>
      </div>
      <div class="col-md-auto">
        <div class="form-check form-check-inline">
          <%= f.check_box :status, { multiple: true, class: "form-check-input", checked: params[:status]&.include?("active"), onchange: "this.form.requestSubmit()" }, "active", nil %>
          <%= f.label :status_active, t('courses.index.show_active'), class: "form-check-label" %>
        </div>
        <div class="form-check form-check-inline">
          <%= f.check_box :status, { multiple: true, class: "form-check-input", checked: params[:status]&.include?("inactive"), onchange: "this.form.requestSubmit()" }, "inactive", nil %>
          <%= f.label :status_inactive, t('courses.index.show_inactive'), class: "form-check-label" %>
        </div>
      </div>
      <div class="col-md-auto ms-auto">
        <%= link_to t('actions.clear'), courses_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>

<table class="table table-striped table-hover table-responsive table-sm">
  <thead>
    <tr>
      <th class="col text-center"><%= t('state.title') %></th>
      <th class="col">
        <%= Course.human_attribute_name(:name) %>
        (<%= t('activerecord.attributes.course.teacher') %>)
      </th>
      <th class="col text-nowrap"><%= Course.human_attribute_name(:start_date) %></th>
      <th class="col"><%= Course.human_attribute_name(:address) %></th>
      <th class="col"><%= Course.human_attribute_name(:weekly_schedule) %></th>
      <th class="col text-center"><%= t('actions.title') %></th>
    </tr>
  </thead>
  <tbody class="align-middle">
    <% @courses.each do |course| %>
      <tr>
        <td class="text-center">
          <span class="badge <%= course_status_badge_class(course) %>">
            <i class="<%= course_status_icon(course) %>"></i>
            <%= t("state.#{(course.state || 'unknown').downcase}") %>
          </span>
        </td>
        <td>
          <span class="fw-bold"><%= course.name %></span>
          <div class="small text-muted">
            <i class="bi bi-person me-1"></i><%= link_to course.teacher.name, teacher_path(course.teacher), class: "text-decoration-none text-muted" %>
          </div>
        </td>
        <td class="small text-nowrap">
          <%= l(course.start_date, format: :long) if course.start_date %>
        </td>
        <td class="small"><%= course.address %></td>
        <td class="small">
          <% course.weekly_schedule.each do |schedule| %>
            <div class="text-nowrap">
              <span class="text-uppercase fw-lighter" style="font-size: 0.8em;"><%= t("weekdays.#{schedule["day"].downcase}") %>:</span>
              <%= schedule["start_time"] %> - <%= schedule["end_time"] %>
            </div>
          <% end %>
        </td>
        <td class="text-center">
          <div class="btn-group">
            <%= link_to t('actions.show'), course, class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to t('activerecord.models.attendance'), attendance_table_course_path(course), class: "btn btn-sm btn-outline-primary" %>
            <%= link_to t('actions.delete'), course, data: { turbo_method: :delete, turbo_confirm: t('actions.confirm') }, class: 'btn btn-outline-danger btn-sm' %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

