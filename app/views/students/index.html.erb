<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('.title') %></h1>
  <%= link_to t('actions.new'), new_student_path, class: "btn btn-primary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <%= form_with url: students_path, method: :get, class: "row g-3 align-items-center" do |f| %>
      <div class="col-md-4">
        <div class="input-group">
          <%= f.text_field :query, value: params[:query], class: "form-control", placeholder: t('students.index.search_placeholder') %>
          <%= f.submit t('actions.search'), class: "btn btn-primary" %>
        </div>
      </div>
      <div class="col-md-auto">
        <div class="form-check form-check-inline">
          <%= f.check_box :status, { multiple: true, class: "form-check-input", checked: params[:status]&.include?("active"), onchange: "this.form.requestSubmit()" }, "active", nil %>
          <%= f.label :status_active, t('students.index.show_active'), class: "form-check-label" %>
        </div>
        <div class="form-check form-check-inline">
          <%= f.check_box :status, { multiple: true, class: "form-check-input", checked: params[:status]&.include?("inactive"), onchange: "this.form.requestSubmit()" }, "inactive", nil %>
          <%= f.label :status_inactive, t('students.index.show_inactive'), class: "form-check-label" %>
        </div>
      </div>
      <div class="col-md-auto ms-auto">
        <%= link_to t('actions.clear'), students_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>

<table class="table table-striped table-hover table-responsive table-sm">
    <thead>
      <tr>
        <th class="col"><%= t('activerecord.attributes.student.first_name') %> / <%= t('activerecord.attributes.student.last_name') %></th>
        <th class="col"><%= t('activerecord.attributes.student.date_of_birth') %></th>
        <th class="col"><%= t('activerecord.attributes.student.email') %></th>
        <th class="col"><%= t('navbar.courses') %></th>
        <th class="col"><%= t('activerecord.attributes.student.status') %></th>
        <th class="col text-end"><%= t('activerecord.attributes.student.total_paid') %></th>
        <th colspan="2" class="text-center"><%= t('actions.title') %></th>
      </tr>
    </thead>

    <tbody class="align-middle">
      <% @students.each do |student| %>
        <tr>
          <td><%= student.full_name %></td>
          <td><%= student.date_of_birth %></td>
          <td><%= student.email %></td>
          <td>
            <% student.courses.active.each do |course| %>
              <span class="badge bg-info text-dark" title="<%= course.teacher.name %>"><%= course.name %></span>
            <% end %>
            <% if student.courses.active.any? && student.courses.inactive.any? %><br/><% end %>
            <% student.courses.inactive.each do |course| %>
              <span class="badge bg-light text-muted" title="<%= course.teacher.name %>"><%= course.name %></span>
            <% end %>
          </td>
          <td>
            <% if student.active? %>
              <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i><%= t('students.status.active') %></span>
            <% else %>
              <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i><%= t('students.status.inactive') %></span>
            <% end %>
          </td>
          <td class="text-end"><%= number_to_currency(student.total_paid, unit: '€') %></td>
          <td class="text-center">
            <div class="btn-group">
              <%= link_to t('actions.show'), student, class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to t('actions.delete'), student, data: { turbo_method: :delete, turbo_confirm: t('actions.confirm') }, class: 'btn btn-outline-danger btn-sm' %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>


