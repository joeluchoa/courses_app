<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('.title') %></h1>
  <%= link_to t('actions.new'), new_student_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped table-hover table-responsive table-sm">
    <thead>
      <tr>
        <th class="col"><%= t('activerecord.attributes.student.first_name') %> / <%= t('activerecord.attributes.student.last_name') %></th>
        <th class="col"><%= t('activerecord.attributes.student.date_of_birth') %></th>
        <th class="col"><%= t('activerecord.attributes.student.email') %></th>
        <th class="col"><%= t('navbar.courses') %></th>
        <th class="col"><%= t('activerecord.attributes.student.total_paid') %></th>
        <th colspan="2"><%= t('actions.title') %></th>
      </tr>
    </thead>

    <tbody class="align-middle">
      <% @students.each do |student| %>
        <tr>
          <td><%= student.full_name %></td>
          <td><%= student.date_of_birth %></td>
          <td><%= student.email %></td>
          <td>
            <% student.courses.each do |course| %>
              <%= "#{course.name} (#{course.teacher.name})" %>
              <br/>
            <% end %>
          </td>
          <td><%= number_to_currency(student.total_paid, unit: '€') %></td>
          <td class="col-2">
            <%= link_to t('actions.show'), student, class: "btn btn-sm btn-secondary" %>
            <%= link_to t('actions.delete'), student, data: { turbo_method: :delete, turbo_confirm: t('actions.confirm') }, class: 'btn btn-danger btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

