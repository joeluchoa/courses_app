<div class="card">
  <div class="card-header">
    <h5><%= t('students.show.enrolled_courses') %> (<%= @student.courses.count %>)</h5>
  </div>
  <div class="card-body">
    <% if @student.courses.any? %>
      <table class="table table-striped table-hover table-borderless table-responsive">
        <thead>
          <tr>
            <th scope="col"><%= t('state.title') %></th>
            <th scope="col"><%= Course.human_attribute_name(:name) %></th>
            <th scope="col"><%= t('students.show.qr_code') %></th>
            <th scope="col"><%= t('students.show.badge') %></th>
          </tr>
        </thead>
        <tbody class="align-middle">
        <% @student.courses.order(:start_date).reverse_order.each do |course| %>
          <tr>
            <td scope="col" class="text-center <%= course_row_color(course) %>"><%= t("state.#{(course.state || 'unknown').downcase}") %></td>
            <td><%= link_to course.name, course_path(course) %></td>
            <td>
              <% if course.in_progress? %>
                <div class="student-show-qr-code">
                  <%= render 'students/qr_code', student: @student, course: course %>
                </div>
              <% else %>
                <%= t('students.show.not_available') %>
              <% end %>
            </td>
            <td>
              <% unless course.finished? %>
                <%= link_to t('students.show.view_badge'), student_badge_path(@student, course), class: "btn btn-sm btn-outline-primary", target: "_blank" %>
                <%= link_to "PDF", student_badge_path(@student, course, format: :pdf), download: "badge-#{@student.full_name.parameterize}-#{course.name.parameterize}.pdf", class: "btn btn-sm btn-primary" %>
              <% else %>
                <%= t('students.show.not_available') %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      </table>
    <% else %>
      <p class="text-muted"><%= t('students.show.no_enrolled_courses') %></p>
    <% end %>
  </div>
</div>

