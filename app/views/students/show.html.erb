<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0"><%= t('.title') %></h5>
    <%= link_to t('actions.back'), students_path, class: "btn btn-sm btn-secondary" %>
  </div>

  <div class="card-body">
    <%= render @student %>
  </div>

  <div class="card-footer d-flex gap-2">
    <%= link_to t('actions.edit'), edit_student_path(@student), class: "btn btn-warning" %>
    <%= button_to t('actions.delete'), @student, method: :delete, class: "btn btn-danger", data: { confirm: t('actions.confirm') } %>
  </div>
</div>

<p></p>
<%= render 'students/enrolled_courses', student: @student %>
<p></p>

