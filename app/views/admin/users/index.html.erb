<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('users.index.title') %></h1>
  <%= link_to t('actions.new'), new_admin_user_path, class: 'btn btn-primary' %>
</div>

<div class="card mb-4 no-pdf">
  <div class="card-body">
    <%= form_with url: admin_users_path, method: :get, class: "row g-3 align-items-center" do |f| %>
      <div class="col-md-4">
        <div class="input-group">
          <%= f.text_field :query, value: params[:query], class: "form-control", placeholder: t('users.index.search_placeholder') %>
          <%= f.submit t('actions.search'), class: "btn btn-primary" %>
        </div>
      </div>
      <div class="col-md-auto">
        <div class="form-check form-check-inline">
          <%= f.check_box :status, { multiple: true, class: "form-check-input", checked: params[:status]&.include?("active"), onchange: "this.form.requestSubmit()" }, "active", nil %>
          <%= f.label :status_active, t('users.index.show_active'), class: "form-check-label" %>
        </div>
        <div class="form-check form-check-inline">
          <%= f.check_box :status, { multiple: true, class: "form-check-input", checked: params[:status]&.include?("blocked"), onchange: "this.form.requestSubmit()" }, "blocked", nil %>
          <%= f.label :status_blocked, t('users.index.show_blocked'), class: "form-check-label" %>
        </div>
      </div>
      <div class="col-md-auto ms-auto">
        <%= link_to t('actions.clear'), admin_users_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>

<table class="table table-striped table-sm table-hover table-responsive">
  <thead>
    <tr>
      <th><%= User.human_attribute_name(:name) %></th>
      <th><%= User.human_attribute_name(:email) %></th>
      <th class="text-center"><%= User.human_attribute_name(:role) %></th>
      <th class="text-center"><%= t('status.title') %></th>
      <th class="text-center"><%= t('actions.title') %></th>
    </tr>
  </thead>
  <tbody class="align-middle">
    <% @users.each do |user| %>
      <tr>
        <td><span class="fw-bold"><%= user.name %></span></td>
        <td><i class="bi bi-envelope me-1 text-muted"></i><%= user.email %></td>
        <td class="text-center">
          <span class="badge bg-info text-dark">
            <%= t("activerecord.enums.user.role.#{user.role}") %>
          </span>
        </td>
        <td class="text-center">
          <% if user.blocked? %>
            <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i><%= t('status.blocked') %></span>
          <% else %>
            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i><%= t('status.active') %></span>
          <% end %>
        </td>
        <td class="text-center">
          <div class="btn-group">
            <%= link_to t('actions.edit'), edit_admin_user_path(user), class: 'btn btn-outline-secondary btn-sm' %>
            <%= link_to t('actions.delete'), admin_user_path(user), data: { turbo_method: :delete, turbo_confirm: t('actions.confirm') }, class: 'btn btn-outline-danger btn-sm' %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

