<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('users.index.title') %></h1>
  <%= link_to t('actions.new'), new_admin_user_path, class: 'btn btn-primary' %>
</div>

<table class="table table-striped table-sm table-hover table-responsive">
  <thead>
    <tr>
      <th class="col-2"><%= User.human_attribute_name(:name) %></th>
      <th class="col-2"><%= User.human_attribute_name(:email) %></th>
      <th class="col-2"><%= User.human_attribute_name(:role) %></th>
      <th class="col-2"><%= t('status.title') %></th>
      <th class="col-2"><%= t('actions.title') %></th>
    </tr>
  </thead>
  <tbody class="align-middle">
    <% @users.each do |user| %>
      <tr>
        <td class="col-2"><%= user.name %></td>
        <td class="col-2"><%= user.email %></td>
        <td class="col-2"><%= t("activerecord.enums.user.role.#{user.role}") %></td>
        <td class="col-2">
          <% if user.blocked_at? %>
            <span class="badge bg-danger"><%= t('status.blocked') %></span>
          <% else %>
            <span class="badge bg-success"><%= t('status.active') %></span>
          <% end %>
        </td>
        <td class="col-2">
          <%= link_to t('actions.edit'), edit_admin_user_path(user), class: 'btn btn-secondary btn-sm' %>
          <%= link_to t('actions.delete'), admin_user_path(user), data: { turbo_method: :delete, turbo_confirm: t('actions.confirm') }, class: 'btn btn-danger btn-sm' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
